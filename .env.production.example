# PostgreSQL — Supabase (separate schema from alter-server)
# Use the same Supabase project; create a second database named managed_bot
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/managed_bot?ssl=require

# Redis — same Upstash instance as alter-server; different key prefixes keep them isolated
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6380

# Shared secret — must match alter-server SERVICE_TOKEN
ALTER_SERVICE_TOKEN=<same value as alter-server SERVICE_TOKEN>

# Inter-service (Docker service name — no external hop)
ALTER_SERVER_URL=http://alter-server:8080

# Public-facing base URL for this service
BASE_URL=https://bot.yourdomain.com

# Encryption key for stored credentials (32 random bytes, base64-encoded)
ENCRYPTION_KEY=<generate: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())">

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# LLM API keys (leave blank to disable the corresponding provider)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
